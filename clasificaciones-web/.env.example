# Copia este fichero a ".env" y rellena tus valores reales.
# ".env" está en .gitignore: nunca lo subas a git.

# ---------------------------------------------------------------------------
# Conexión a MySQL (obligatoria)
# ---------------------------------------------------------------------------
# Cadena de conexión SIN contraseña (SQLPage la añade a partir de
# DATABASE_PASSWORD; así la contraseña no queda escrita en la URL).
# Formato: mysql://usuario@host:puerto/nombre_basedatos
#
# OJO: este valor NO cambia entre local y servidor si usas
# docker-compose.network.yml en los dos sitios (recomendado, ver
# ../clasificaciones-data/README.md): "clasificaciones-data" es el NOMBRE
# del contenedor en la red Docker compartida, no una IP ni un dominio, así
# que es el mismo valor te ejecutes donde te ejecutes.
#
# Si en vez de eso usaras el MySQL de desarrollo desechable
# (docker-compose.dev.yml), el host sería "mysql" en lugar de
# "clasificaciones-data" — descomenta esa línea y comenta la otra:
#DATABASE_URL=mysql://clasificaciones_app@mysql:3306/clasificaciones
DATABASE_URL=mysql://clasificaciones_app@clasificaciones-data:3306/clasificaciones

# Contraseña del usuario de MySQL indicado arriba.
DATABASE_PASSWORD=[cambiar aqui]

# ---------------------------------------------------------------------------
# SQLPage
# ---------------------------------------------------------------------------
# "development" muestra errores detallados y desactiva la caché de ficheros.
# "production" oculta detalles de error internos y cachea las páginas.
# Esto SÍ cambia según dónde lo ejecutes — deja activa solo una línea:
#Local
SQLPAGE_ENVIRONMENT=development
#Servidor
#SQLPAGE_ENVIRONMENT=production

# Puerto en el que se expone la aplicación en tu máquina (http://localhost:PUERTO)
SQLPAGE_PORT=8080

# ---------------------------------------------------------------------------
# Solo para desarrollo local con docker-compose.dev.yml
# (un MySQL local de usar y tirar, cargado con database/schema.sql
#  y database/sample_data.sql). No se usa en producción.
# ---------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=[cambiar aqui]
MYSQL_DATABASE=clasificaciones
MYSQL_USER=clasificaciones_app
MYSQL_PASSWORD=[cambiar aqui]
