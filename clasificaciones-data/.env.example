# Copia este fichero a ".env" y pon contraseñas reales ahí (nunca aquí,
# ni en el README, ni en el docker-compose.yml: ".env" está en .gitignore
# y esos otros ficheros sí se versionan).
#
# Para un servidor real usa contraseñas fuertes generadas aparte, no
# palabras cortas tipo "pass" — este MySQL va a estar accesible desde
# otro contenedor por red, así que merece una contraseña seria.

MYSQL_ROOT_PASSWORD=[cambiar aqui]
MYSQL_USER=clasificaciones_app
MYSQL_PASSWORD=[cambiar aqui]

# No hay ningún "DATABASE_URL" ni dirección que poner aquí: este .env es
# para el propio contenedor de MySQL, no para quien se conecta a él. Ese
# valor va en clasificaciones-web/.env (quien sí se conecta A esto).

# Puerto de MySQL publicado al host. clasificaciones-web NO lo necesita
# (se conecta por red interna de Docker, ver README), así que esto es solo
# para poder entrar con un cliente MySQL desde fuera de Docker si quieres.
#Local
MYSQL_PORT=3306
#Servidor
# En el servidor probablemente NO quieras publicar el puerto de MySQL a
# Internet por seguridad. El valor en sí no es peligroso si el firewall
# del servidor no lo abre hacia fuera; si quieres cerrarlo del todo, quita
# el "ports:" del servicio mysql en docker-compose.yml.
